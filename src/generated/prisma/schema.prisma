generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TastingRecord {
  id         Int      @id @default(autoincrement())
  coffeeName String
  score      Int
  notes      String?
  altitude   Int? // 標高（メートル）
  createdAt  DateTime @default(now())
}
